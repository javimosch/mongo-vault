PORT=3011
NODE_ENV=development

# MongoDB connection
MONGODB_URI=mongodb://localhost:27017/mongo-vault

# Basic auth for the dashboard and API
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Encryption key for sensitive data (SSH keys, etc.)
# Must be at least 16 characters. If not set, a default key is used (not recommended for production).
ENCRYPTION_KEY=change-me-to-a-random-secret-at-least-32-chars

# CORS (set to your dashboard domain in production)
CORS_ORIGIN=*
