PORT=3011
NODE_ENV=development

# MongoDB connection
MONGODB_URI=mongodb://localhost:27017/mongo-vault

# Basic auth for the dashboard and API
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Encryption key for sensitive data (SSH keys stored encrypted at rest in MongoDB)
# Must be 32+ characters. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=change-me-to-a-random-secret-at-least-32-chars

# CORS (set to your dashboard domain in production)
CORS_ORIGIN=*
